<mujoco model="pointmaze-impasse">
	<option timestep="0.01" />
	<compiler angle="radian" />

	<worldbody>

		<!-- Floor -->
		<geom name="floor" type="plane" size="0 0 0.1" rgba="0.8 0.8 0.8 1" />

		<!-- Walls -->
		<geom name="bwall" type="box" size="2 0.1 0.8" pos="0 0 0.2" rgba="0.6 0.6 0.6 1" />
		<geom name="lwall" type="box" size="0.1 3 0.8" pos="-2 0 0.2" rgba="0.6 0.6 0.6 1" />
		<geom name="rwall" type="box" size="0.1 3 0.8" pos="2 0 0.2" rgba="0.6 0.6 0.6 1" />

		<!-- Points -->
		<geom name="goal" type="sphere" size="0.25" pos="0 -1 0.5" rgba="0 1 0 1" />

		<body name="agent" pos="0 4 0.5">
			<geom name="agent_body" type="sphere" size="0.25" rgba="0 0 1 1" />
			<joint name="x_joint" type="slide" axis="1 0 0" />
			<joint name="y_joint" type="slide" axis="0 1 0" />

			
		</body>

	</worldbody>

	<actuator>
		<motor name="x_motor" joint="x_joint" ctrlrange="-1 1" />
		<motor name="y_motor" joint="y_joint" ctrlrange="-1 1" />
	</actuator>

	
</mujoco>